# Normalize every text file to LF in the index and working tree.
* text=auto eol=lf

# Explicit authored text families keep Git classification deterministic.
*.rs text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.hxx text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.sample text eol=lf

# Binary families never participate in newline normalization or textual diffs.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
